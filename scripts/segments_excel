#!/usr/bin/env python3
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

import pandas as pd

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from playdia_codec.codec import Picture

def resolve_video_dir(video: str) -> Path:
    path = Path(video)
    if path.is_dir():
        return path
    return ROOT / "output" / "frames" / video

def segment_rows(video_dir: Path, *, include_bits: bool):
    records: list[dict[str, object]] = []
    frame_paths = sorted(video_dir.glob("frame_*.bin"))
    for frame_path in frame_paths:
        p = Picture(frame_path)
        for lmb in p.video_stream.rows:
            p_dic = p.to_dict()
            records.append({
                "frame_id":p.frame_id,
                "ptype": p_dic["ptype"],
                "qbs": p_dic["qbs"],
                "factor": p_dic["factor"],
                "id": lmb.lmbn,
                "offset": lmb.byte_offset,
                "bit": lmb.bit_offset,
                "dcseed": lmb.dcseed,
                "len": len(lmb.data.bin),
                "data": "" if not include_bits else lmb.data.bin
            })

    return records


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Dump all frame segments for one video to an Excel workbook.")
    parser.add_argument("video", help="video id such as 001, or a directory containing frame_*.bin files")
    parser.add_argument("-o", "--output", type=Path, help="output .xlsx path")
    parser.add_argument("--no-bits", action="store_true", help="omit payload_bits strings")
    args = parser.parse_args(argv)

    video_dir = resolve_video_dir(args.video)
    if not video_dir.is_dir():
        parser.error(f"video directory does not exist: {video_dir}")

    output = args.output or (ROOT / "output" / f"{video_dir.name}_segments.xlsx")
    output.parent.mkdir(parents=True, exist_ok=True)

    records = segment_rows(
        video_dir,
        include_bits=not args.no_bits
    )
    df = pd.DataFrame(records)
    with pd.ExcelWriter(output, engine="openpyxl") as writer:
        df.to_excel(writer, index=False, sheet_name="segments")
        sheet = writer.book["segments"]
        for column_index, column_name in enumerate(df.columns, start=1):
            if column_name == "data":
                for column_cells in sheet.iter_cols(min_col=column_index, max_col=column_index):
                    for cell in column_cells:
                        cell.number_format = "@"
    print(f"wrote {len(df)} rows to {output}")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
