#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$project_dir/venv/bin/python" ]; then
    exec "$project_dir/venv/bin/python" "$project_dir/launcher.py"
fi
if [ -x "$project_dir/.venv/bin/python" ]; then
    exec "$project_dir/.venv/bin/python" "$project_dir/launcher.py"
fi
exec python3 "$project_dir/launcher.py"
